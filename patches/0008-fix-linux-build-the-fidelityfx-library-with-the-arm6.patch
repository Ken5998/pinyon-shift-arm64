Date: Mon, 19 Oct 2026 16:24:50 +0000
Subject: [PATCH 8/8] fix(linux): build the fidelityfx library with the arm64
 toolchain

ShiftGlue configures the FidelityFX library (FSR 2 and 3) as a
separate CMake project during the game build and passes it only the
compilers, not the toolchain file. On ArmadaOS that project linked
with the default ld, which the system does not have, so the build
stopped at its configure. A new build tree takes its toolchain file
from CMAKE_TOOLCHAIN_FILE in the environment, so setup sets it for
linux-arm64 builds, and a failed configure of that tree starts over.

Tests: python3 -m unittest discover -s tools/tests (no new failures);
fidelityfx-vk configured and built for aarch64 against the pinned
sysroot with the variable set
---
 tools/pinyon_setup.py            | 9 +++++++++
 tools/tests/test_pinyon_setup.py | 5 +++++
 2 files changed, 14 insertions(+)

diff --git a/tools/pinyon_setup.py b/tools/pinyon_setup.py
index ceaee62d..c4a95a69 100644
--- a/tools/pinyon_setup.py
+++ b/tools/pinyon_setup.py
@@ -859,6 +859,12 @@ def build_environment(tools: dict, target: str) -> dict:
     environment["PATH"] = os.pathsep.join(paths + [environment.get("PATH", "")])
     environment["SOURCE_DATE_EPOCH"] = SOURCE_DATE_EPOCH
     environment["PINYON_LINUX_TOOLCHAIN"] = str(toolchain_folder(target))
+    if target == "linux-arm64":
+        # ShiftGlue configures the FidelityFX library as a separate project
+        # at build time and passes it only the compilers. A new build tree
+        # takes its toolchain file from this variable, so that project links
+        # with the pinned lld against the sysroot too: ArmadaOS has no ld.
+        environment["CMAKE_TOOLCHAIN_FILE"] = str(ROOT / "cmake/toolchains/linux-arm64.cmake")
     return environment
 
 
@@ -994,6 +1000,8 @@ def build(progress: Progress, tools: dict, sdk: Path, python: Path, name: str,
                LOGS / "preview-configure.log", progress, "build", 28, 30,
                "Configuring the game", environment)
     directory = ROOT / "out" / "build" / preset
+    # Configured during the build, so a failed attempt there is retried too.
+    discard_unfinished_configure(directory / "fidelityfx-vk")
     run_game_build([cmake, "--build", "--preset", preset, "--parallel", str(jobs)],
                    LOGS / "preview-build.log", progress, 30, "Building the game", environment,
                    directory, generated)
@@ -1121,6 +1129,7 @@ def build_v4(progress: Progress, tools: dict, sdk: Path, python: Path, name: str
                  f"-DCMAKE_CXX_FLAGS={CPU_BASELINE_FLAGS[baseline]}"]
     directory = ROOT / "out" / "build" / preset
     discard_unfinished_configure(directory)
+    discard_unfinished_configure(directory / "fidelityfx-vk")
     # A release install keeps the SDK in .local/rexglue, not in the submodule
     # path the preset names (#459).
     run_logged([cmake, "--preset", preset, f"-DREXSDK_DIR={sdk}", f"-DPYTHON_EXECUTABLE={python}",
diff --git a/tools/tests/test_pinyon_setup.py b/tools/tests/test_pinyon_setup.py
index 8fa787eb..54ca8b08 100644
--- a/tools/tests/test_pinyon_setup.py
+++ b/tools/tests/test_pinyon_setup.py
@@ -167,6 +167,11 @@ class ToolchainPinTests(unittest.TestCase):
             pinyon_setup.discard_unfinished_configure(build)
             self.assertTrue((build / "CMakeCache.txt").exists())
 
+    def test_an_arm64_build_hands_its_toolchain_to_new_build_trees(self):
+        environment = pinyon_setup.build_environment({}, "linux-arm64")
+        self.assertEqual(environment["CMAKE_TOOLCHAIN_FILE"],
+                         str(pinyon_setup.ROOT / "cmake/toolchains/linux-arm64.cmake"))
+
     def test_a_build_whose_translation_rewrote_the_lists_runs_again(self):
         with tempfile.TemporaryDirectory() as temp:
             build = Path(temp) / "build"
