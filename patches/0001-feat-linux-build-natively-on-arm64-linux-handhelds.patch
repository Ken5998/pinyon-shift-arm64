diff --git a/cmake/toolchains/linux-arm64.cmake b/cmake/toolchains/linux-arm64.cmake
new file mode 100644
index 0000000..0ba841e
--- /dev/null
+++ b/cmake/toolchains/linux-arm64.cmake
@@ -0,0 +1,51 @@
+# ARM64 Linux (aarch64) with the pinned LLVM against the build host's own
+# headers and libraries, for ARM handhelds such as the Retroid Pocket 6 or
+# the AYN Odin 2 running ArmadaOS, ROCKNIX-derived or other desktop Linux.
+#
+# There is no Steam Runtime sysroot for ARM64, so the host provides glibc,
+# libstdc++, X11 and Wayland development files. On an image-based system
+# (ArmadaOS, Fedora Atomic) build inside a distrobox of the same Fedora
+# release; the game then runs on the host (docs/LINUX_ARM64.md). libstdc++
+# is linked statically, as on x86-64, so a newer container GCC never needs a
+# newer host library.
+#
+# PINYON_LINUX_TOOLCHAIN (cache or environment) holds:
+#   llvm/          LLVM 20.1.8 for ARM64 Linux
+#   bin/ld.lld     setup's link to the linker that runs on this host
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+
+if(NOT PINYON_LINUX_TOOLCHAIN)
+  if(DEFINED ENV{PINYON_LINUX_TOOLCHAIN})
+    set(PINYON_LINUX_TOOLCHAIN "$ENV{PINYON_LINUX_TOOLCHAIN}")
+  else()
+    get_filename_component(_pinyon_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
+    set(PINYON_LINUX_TOOLCHAIN "${_pinyon_root}/.local/toolchain/linux-arm64")
+  endif()
+endif()
+set(PINYON_LINUX_TOOLCHAIN "${PINYON_LINUX_TOOLCHAIN}" CACHE PATH
+    "Pinned LLVM and linker link for ARM64 Linux builds")
+# try_compile projects reload this file without the cache.
+list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PINYON_LINUX_TOOLCHAIN)
+
+set(_pinyon_llvm "${PINYON_LINUX_TOOLCHAIN}/llvm")
+set(CMAKE_C_COMPILER "${_pinyon_llvm}/bin/clang")
+set(CMAKE_CXX_COMPILER "${_pinyon_llvm}/bin/clang++")
+set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
+set(CMAKE_AR "${_pinyon_llvm}/bin/llvm-ar" CACHE FILEPATH "")
+set(CMAKE_RANLIB "${_pinyon_llvm}/bin/llvm-ranlib" CACHE FILEPATH "")
+foreach(_pinyon_lang C CXX ASM)
+  # Clang finds the distribution's GCC (aarch64-redhat-linux on Fedora,
+  # aarch64-linux-gnu on Debian) for this target on its own.
+  set(CMAKE_${_pinyon_lang}_COMPILER_TARGET aarch64-linux-gnu)
+endforeach()
+
+set(_pinyon_link "-fuse-ld=lld -static-libstdc++")
+# The LLVM release's ld.lld needs libxml2.so.2, which current distributions
+# no longer ship; setup links bin/ld.lld to one that runs here.
+if(EXISTS "${PINYON_LINUX_TOOLCHAIN}/bin/ld.lld")
+  string(APPEND _pinyon_link " --ld-path=${PINYON_LINUX_TOOLCHAIN}/bin/ld.lld")
+endif()
+set(CMAKE_EXE_LINKER_FLAGS_INIT "${_pinyon_link}")
+set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_pinyon_link}")
+set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_pinyon_link}")
