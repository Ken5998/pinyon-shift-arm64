From f2d2ff191b9c7db236dc005f509b580433c4732c Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Tue, 13 Oct 2026 13:48:24 +0000
Subject: [PATCH 2/8] feat(linux): cross-build the arm64 game on x86-64 linux

A handheld is a poor place for a 30 GB build. setup --target
linux-arm64 on x86-64 Debian or Ubuntu (WSL included) builds the
translator for the PC and the game for aarch64 with the pinned x86-64
LLVM against the distribution's arm64 multiarch packages and aarch64
cross GCC, then names the packages to install when they are missing.
Built against glibc 2.39, the game runs on Fedora 44 based ArmadaOS.

Tests: cross-built the host tests and GPU plugin through the setup
toolchain layout on Ubuntu 24.04; 11 of 11 pass under qemu-aarch64
---
 cmake/toolchains/linux-arm64.cmake | 12 ++++
 docs/LINUX_ARM64.md                | 44 ++++++++++++--
 tools/pinyon_setup.py              | 97 +++++++++++++++++++++++++-----
 3 files changed, 133 insertions(+), 20 deletions(-)

diff --git a/cmake/toolchains/linux-arm64.cmake b/cmake/toolchains/linux-arm64.cmake
index 0ba841e7..fbbbf791 100644
--- a/cmake/toolchains/linux-arm64.cmake
+++ b/cmake/toolchains/linux-arm64.cmake
@@ -49,3 +49,15 @@ endif()
 set(CMAKE_EXE_LINKER_FLAGS_INIT "${_pinyon_link}")
 set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_pinyon_link}")
 set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_pinyon_link}")
+
+# On an x86-64 Debian or Ubuntu host (WSL included) the target's libraries
+# are the distribution's arm64 multiarch packages beside the host's, and its
+# C++ runtime the aarch64 cross GCC's, which clang finds for this target.
+# Built against Ubuntu 24.04 (glibc 2.39), the game runs on newer systems
+# such as Fedora 44.
+if(NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64")
+  set(CMAKE_LIBRARY_ARCHITECTURE aarch64-linux-gnu)
+  set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+  set(ENV{PKG_CONFIG_LIBDIR} "/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig")
+  set(ENV{PKG_CONFIG_PATH} "")
+endif()
diff --git a/docs/LINUX_ARM64.md b/docs/LINUX_ARM64.md
