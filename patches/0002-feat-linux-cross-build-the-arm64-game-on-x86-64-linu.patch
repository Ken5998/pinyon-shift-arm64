+# On an x86-64 Debian or Ubuntu host (WSL included), the ARM64 build uses the
+# distribution's aarch64 cross GCC and its multiarch arm64 libraries.
+ARM64_CROSS_PACKAGES = (
+    "g++-14-aarch64-linux-gnu libwayland-bin wayland-protocols pkg-config "
+    + " ".join(f"{package}:arm64" for package in (
+        "libx11-dev", "libx11-xcb-dev", "libxcb1-dev", "libxext-dev", "libxcursor-dev",
+        "libxi-dev", "libxrandr-dev", "libxss-dev", "libxfixes-dev", "libxtst-dev",
+        "libxkbcommon-dev", "libwayland-dev", "libdecor-0-dev", "libegl-dev", "libgl-dev",
+        "libgles-dev", "libdrm-dev", "libgbm-dev", "libasound2-dev", "libpulse-dev",
+        "libpipewire-0.3-dev", "libudev-dev", "libdbus-1-dev")))
+ARM64_CROSS_PKG_CONFIG_LIBDIR = "/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig"
+
+
+def toolchain_folder(target: str) -> Path:
+    """What PINYON_LINUX_TOOLCHAIN names for a build of target on this host."""
+    if target == "linux-arm64" and host_platform() == "linux-x86_64":
+        return LOCAL / "toolchain" / "linux-arm64-cross"
+    return LOCAL / "toolchain" / target
+
+
+def prepare_linux_arm64_cross_toolchain(tools: dict) -> None:
+    """The layout cmake/toolchains/linux-arm64.cmake reads on an x86-64 host:
+    llvm/ is the pinned x86-64 LLVM, which targets aarch64 as well, and
+    bin/ld.lld its linker wrapper from the x86-64 toolchain."""
+    folder = toolchain_folder("linux-arm64")
+    (folder / "bin").mkdir(parents=True, exist_ok=True)
+    for link, target in (("llvm", ROOT / tools["llvm"]["install_path"]),
+                         ("bin/ld.lld", LOCAL / "toolchain" / "linux-x86_64" / "bin" / "ld.lld")):
+        path = folder / link
+        if path.is_symlink() or path.exists():
+            path.unlink()
+        os.symlink(str(target), str(path))
+    missing = []
+    if not Path("/usr/lib/gcc-cross/aarch64-linux-gnu").is_dir():
+        missing.append("the aarch64 cross GCC")
+    for name in ("pkg-config", "wayland-scanner"):
+        if not shutil.which(name):
+            missing.append(name)
+    if shutil.which("pkg-config"):
+        environment = dict(os.environ, PKG_CONFIG_LIBDIR=ARM64_CROSS_PKG_CONFIG_LIBDIR,
+                           PKG_CONFIG_PATH="")
+        missing += [f"{module} (arm64)" for module in ARM64_PKG_CONFIG
+                    if subprocess.run(["pkg-config", "--exists", module],
+                                      env=environment).returncode]
+    if missing:
+        raise SetupError(
+            "building for ARM64 on this PC needs the aarch64 cross compiler and arm64 "
+            "development files (" + ", ".join(missing) + "). On Ubuntu or Debian, add the "
+            "arm64 architecture (docs/LINUX_ARM64.md) and install: sudo apt install "
+            + ARM64_CROSS_PACKAGES, "tools")
+
+
 def require_xcode_tools() -> None:
     probe = subprocess.run(["xcode-select", "-p"], capture_output=True, text=True)
     if probe.returncode or not shutil.which("clang++"):
@@ -748,13 +801,12 @@ def run_logged(command: list, log: Path, progress: Progress, stage: str, start:
