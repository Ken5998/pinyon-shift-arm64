From 1fc1a8eff0566b407522d1881d16b9c303d1b76a Mon Sep 17 00:00:00 2001
From: Ken5998 <46025606+Ken5998@users.noreply.github.com>
Date: Tue, 13 Oct 2026 19:54:58 +0000
Subject: [PATCH 7/8] fix(config): add the new-file settings a config lacks at
 start

The launch scripts build the mods before they start the game, and on a
player's first start build-mod-patches.py creates pinyon_shift.toml with
only enabled_mods and the immersive camera's settings. The game then
only added its schema line, so the player had no keyboard (mnk_mode is
off by default), no key binds and the older renderer settings, such as
clear_memory_page_state on.

Each start now adds the settings a new file has and the file lacks,
keeping the player's own values. The list comes from the new-file code
itself, written to a sample file next to the config.
---
 src/pinyon_shift_app.cpp | 58 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 56 insertions(+), 2 deletions(-)

diff --git a/src/pinyon_shift_app.cpp b/src/pinyon_shift_app.cpp
index 937adf63..e80e1f12 100644
--- a/src/pinyon_shift_app.cpp
+++ b/src/pinyon_shift_app.cpp
@@ -584,6 +584,60 @@ bool EnsureSupportedConfig(const std::filesystem::path& path, bool& created,
   }
 }
 
+// The launch scripts build the mods before they start the game, and on a
+// player's first start that step creates this file with only the mods' lines
+// (enabled_mods and the immersive camera's settings). The game then only added
+// its schema line, so the player had no keyboard (mnk_mode), no key binds and
+// the older renderer settings. Each start now adds the settings a new file
+// has and this one lacks; the player's own values stay. The new file is
+// written by the code above, so the two cannot drift apart.
+bool EnsureCompleteConfig(const std::filesystem::path& path, bool& created,
+                          bool& migrated) {
+  if (!EnsureSupportedConfig(path, created, migrated)) {
+    return false;
+  }
+  if (created) {
+    return true;
+  }
+  std::filesystem::path sample = path;
+  sample += ".new";
+  std::error_code error;
+  std::filesystem::remove(sample, error);
+  bool sample_created = false;
+  bool sample_migrated = false;
+  const auto defaults = EnsureSupportedConfig(sample, sample_created, sample_migrated)
+                            ? pinyon_shift::config::ReadFile(sample)
+                            : std::nullopt;
+  std::filesystem::remove(sample, error);
+  const auto text = pinyon_shift::config::ReadFile(path);
+  if (!defaults || !text) {
+    return true;
+  }
+  std::string completed = *text;
+  std::istringstream lines(*defaults);
+  for (std::string line; std::getline(lines, line);) {
+    const size_t equals = line.find(" = ");
+    if (line.empty() || line.front() == '#' || equals == std::string::npos) {
+      continue;
+    }
+    const std::string name = line.substr(0, equals);
+    if (std::regex_search(completed, std::regex("(?:^|\\n)\\s*" + name + "\\s*="))) {
+      continue;
+    }
+    if (!completed.empty() && completed.back() != '\n') {
+      completed.push_back('\n');
+    }
+    completed += line + "\n";
+  }
+  if (completed != *text) {
+    pinyon_shift::config::Backup(path);
+    if (pinyon_shift::config::WriteAtomically(path, completed)) {
+      migrated = true;
+    }
+  }
+  return true;
+}
+
 // The GPU stopped answering: usually a driver reset after a frame took too
 // long (TDR) on a weak or integrated GPU, or a driver fault. The SDK used to
 // abort without a word (0xC0000409); say what happened and exit 1309 so the
@@ -725,8 +779,8 @@ void PinyonShiftApp::OnConfigurePaths(rex::PathConfig& paths) {
 
   bool config_created = false;
   bool config_migrated = false;
-  if (!EnsureSupportedConfig(paths.config_path, config_created,
-                             config_migrated)) {
+  if (!EnsureCompleteConfig(paths.config_path, config_created,
+                            config_migrated)) {
     diagnostics::RecordEvent("config.unsupported",
                              {{"path", rex::path_to_utf8(paths.config_path)},
                               {"required_schema", std::to_string(kConfigSchema)}});
