 .../Installation.cs                           |  6 ++++--
 .../MainWindow.axaml.cs                       |  5 +++--
 launcher/Shared/LauncherUpdate.cs             |  4 +++-
 tools/package-launcher.py                     | 21 ++++++++++++-------
 tools/tests/test_release_contract.py          |  4 ++++
 6 files changed, 44 insertions(+), 16 deletions(-)

